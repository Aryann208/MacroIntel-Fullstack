# Copy to .env at repository root. Never commit .env.
# Browser API origin: public and bundled at web build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
# HTTP port and the single permitted browser origin.
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Local infrastructure URLs; development defaults have no credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/macrointel
REDIS_URL=redis://127.0.0.1:6379
QDRANT_URL=http://127.0.0.1:6333
# Dependency deadline in milliseconds (100–10000).
DEPENDENCY_TIMEOUT_MS=1500
# API and worker JSON log level.
LOG_LEVEL=info
# Docker port overrides: update matching connection URLs above.
MONGODB_PORT=27017
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334