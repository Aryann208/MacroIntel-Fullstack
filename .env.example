# Copy to .env at repository root. Never commit .env.
# Public API origin is bundled into the web build.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Local API port and the single permitted browser origin.
# On a host such as Render, PORT takes precedence over API_PORT.
# PORT=10000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Local MongoDB container. For Atlas, use its mongodb+srv:// connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/macrointel
# MongoDB connection timeout in milliseconds (100-10000).
DEPENDENCY_TIMEOUT_MS=1500

# API logging and auth. Replace JWT_SECRET before any public deployment.
LOG_LEVEL=info
JWT_SECRET=replace-with-a-random-string-at-least-32-characters

# Uncomment and set a real key only when running manual FRED ingestion.
# FRED_API_KEY=your-32-character-fred-api-key

# Local Docker port override: update MONGODB_URI to match.
MONGODB_PORT=27017
