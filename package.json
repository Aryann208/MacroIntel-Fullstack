{
  "name": "macrointel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || \u003e=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @macrointel/contracts build \u0026\u0026 pnpm --parallel --filter @macrointel/web --filter @macrointel/api --filter @macrointel/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @macrointel/contracts build \u0026\u0026 pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm --filter @macrointel/contracts build \u0026\u0026 vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "20.19.43",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11",
    "tsx": "4.23.13"
  },
  "type": "module"
}
